[Unit]
Description=opencode agent
# Démarré explicitement par wsagent après le montage de /workspace
ConditionPathIsMountPoint=/workspace
After=wsagent.service

[Service]
User=coder
Group=coder
# --port est indispensable : sans lui, opencode écoute sur un port aléatoire
# (défaut 0). --hostname 127.0.0.1 est le défaut, explicité ici.
ExecStart=/usr/local/bin/opencode serve --port 4096 --hostname 127.0.0.1
WorkingDirectory=/workspace
Environment=HOME=/home/coder
Restart=on-failure
RestartSec=2s
StandardOutput=journal
StandardError=journal
