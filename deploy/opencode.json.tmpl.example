{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "interne": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LLM interne",
      "options": {
        "baseURL": "{{ .endpoint }}",
        "apiKey": "{{ .api_key }}"
      },
      "models": {
        "{{ .model }}": {}
      }
    }
  },

  "model": "interne/{{ .model }}",

  "permission": {
    "edit": "allow",
    "bash": "ask"
  }
}
