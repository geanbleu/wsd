[Unit]
Description=wsd — workspace daemon Firecracker
Documentation=file:/usr/share/doc/wsd/OPS.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/dev/kvm

[Service]
Type=simple
ExecStart=/usr/local/bin/wsd -config /etc/wsd/wsd.json
Restart=on-failure
RestartSec=5

# wsd a besoin de root pour créer les netns, les veth et les règles nftables.
User=root
Group=root

# /run/wsd, recréé à chaque démarrage. wsd y place wsd.sock en 0660 et donne
# le socket au groupe de config socket_group (défaut wsd), pour wsproxy.
RuntimeDirectory=wsd
RuntimeDirectoryMode=0750

# Journalisation structurée
StandardError=journal
SyslogIdentifier=wsd

# Limites
LimitNOFILE=65536

# Un arrêt ne doit pas tuer les firecracker lancés sous jailer : ils sont dans
# leurs propres cgroups et les workspaces survivent à un redémarrage de wsd.
KillMode=process
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
