# Versions épinglées — wsd
# Mettre à jour manuellement après validation sur un host de staging.
# Sources :
#   Firecracker : https://github.com/firecracker-microvm/firecracker/releases
#   code-server  : https://github.com/coder/code-server/releases
#   opencode     : https://github.com/anomalyco/opencode/releases
#   Go           : https://go.dev/doc/devel/release
#   Kernel       : https://www.kernel.org (série LTS 6.12)

FIRECRACKER_VERSION=v1.17.0
JAILER_VERSION=v1.17.0

CODE_SERVER_VERSION=v4.123.0

# anomalyco/opencode — asset opencode-linux-x64.tar.gz, contenant un unique
# exécutable « opencode » (binaire Bun, ~215 Mio décompressé, lié à la glibc).
# Variantes publiées pour la même version :
#   -musl      pour une base Alpine (l'invité est Debian : ne pas utiliser)
#   -baseline  pour les CPU sans AVX2
# Aucune somme de contrôle n'est publiée pour ces archives.
# Le schéma de opencode.json dépend de la majeure : la série 1.x est « V1 » et
# veut « provider » et « permission » au singulier (cf. docs/CONFIG.md).
OPENCODE_VERSION=v1.19.4

# Go pour le build du host et de wsagent
GO_VERSION=1.26.3

# Kernel LTS invité (série 6.12) — config depuis resources/guest_configs/ du repo Firecracker
KERNEL_VERSION=6.12.114
